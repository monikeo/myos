{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/",
  "name": "MyOS Personal Operating System",
  "short_name": "MyOS",
  "description": "High-craft real-time personal operating system and workspace coordination suite.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#09090b",
  "theme_color": "#10b981",
  "categories": ["productivity", "utilities", "business"],
  "icons": [
    {
      "src": "/logo.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    },
    {
      "src": "/logo.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any maskable"
    },
    {
      "src": "/logo.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Todo List",
      "short_name": "Tasks",
      "url": "/#todo",
      "description": "Open task and backlog board",
      "icons": [{ "src": "/logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Projects",
      "short_name": "Projects",
      "url": "/#projects",
      "description": "Monitor active project boards",
      "icons": [{ "src": "/logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Workspaces",
      "short_name": "Workspaces",
      "url": "/#workspaces",
      "description": "Open workspace clusters",
      "icons": [{ "src": "/logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Finance Ledger",
      "short_name": "Finance",
      "url": "/#finance",
      "description": "View cashflow and project expenses",
      "icons": [{ "src": "/logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Notes",
      "short_name": "Notes",
      "url": "/#notes",
      "description": "Quick notes and documentation",
      "icons": [{ "src": "/logo.png", "sizes": "192x192" }]
    }
  ]
}
